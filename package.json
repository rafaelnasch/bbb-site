{
  "name": "bbb-site",
  "version": "0.1.0",
  "private": true,
  "description": "Novo site da Banheiras Bom Banho: gerador estático próprio em Node, publicado no GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "normalize": "node build/normalize.mjs",
    "media": "node build/media-photos.mjs && node build/media-plantas.mjs && node build/cotas.mjs && node build/normalize.mjs",
    "films": "node build/films.mjs",
    "og": "node build/og.mjs",
    "build": "node build/render.mjs && node build/seo.mjs && node build/validate.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:dados": "node --test tests/data.test.mjs",
    "test:midia": "node --test tests/media.test.mjs",
    "e2e": "playwright test tests/e2e",
    "lhci": "INDEXAR=true node build/render.mjs && INDEXAR=true node build/seo.mjs && lhci autorun",
    "all": "npm run normalize && npm run media && npm run films && npm run media:home && npm run og && npm run build && npm run fontes:titulo && npm test",
    "brand": "node build/brand.mjs",
    "fontes": "node build/fontes.mjs",
    "build:sistema": "node build/render.mjs --sistema",
    "test:nucleo": "node --test tests/nucleo.test.mjs",
    "e2e:nucleo": "node build/render.mjs --sistema && playwright test tests/e2e/nucleo.spec.mjs",
    "test:filmes": "node --test tests/filmes.test.mjs",
    "test:colecoes": "node --test tests/colecoes.test.mjs",
    "e2e:escolha": "node build/render.mjs && playwright test tests/e2e/escolha.spec.mjs",
    "test:produto": "node --test tests/produto.test.mjs",
    "e2e:produto": "node build/render.mjs && playwright test tests/e2e/produto.spec.mjs",
    "media:fabrica": "node build/media-fabrica.mjs",
    "test:home": "node --test tests/home.test.mjs",
    "e2e:home": "node build/render.mjs && playwright test tests/e2e/home.spec.mjs",
    "media:home": "node build/media-home.mjs",
    "fontes:titulo": "node build/fontes-titulo.mjs",
    "test:seo": "node --test tests/seo.test.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "fast-glob": "3.3.3",
    "gsap": "3.15.0",
    "html-validate": "11.16.4",
    "lightningcss": "1.33.0",
    "pdfjs-dist": "6.4.299",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5"
  }
}
